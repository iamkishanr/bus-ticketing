# Postgres from docker-compose.yml
DATABASE_URL="postgresql://bus:bus@localhost:5433/bus_ticketing?schema=public"

# HMAC key for QR ticket tokens. Must be at least 32 bytes; app refuses to start otherwise.
# Generate with: openssl rand -hex 32
TICKET_TOKEN_SECRET="32278eb973d5561930ef452de3d27c32bccf73af833e05e177b06226643f574d"

# Demo role passcodes (KTD8)
ADMIN_PASSCODE="admin-demo"
CONDUCTOR_PASSCODE="conductor-demo"

# Seat hold duration in minutes. Lower it to demo expiry (AE1).
HOLD_DURATION_MINUTES="10"
